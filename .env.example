# Which model provider to use: google (default, free tier) | groq (free tier) | ollama (local, free) | anthropic (paid)
LLM_PROVIDER=google

# Google Gemini — free key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: comma-separated model list; later ones are backups when the first is overloaded
# LLM_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite

# Other providers (only needed if you switch LLM_PROVIDER)
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
